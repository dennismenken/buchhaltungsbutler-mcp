{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!dist/**",
      "!node_modules/**",
      "!coverage/**",
      "!docs/**",
      "!pnpm-lock.yaml",
      "!src/generated/**",
      "!src/registry/index.generated.ts"
    ]
  }
}
