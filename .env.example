# Vorlage für die Umgebungsvariablen des BuchhaltungsButler-MCP-Servers.
#
# Diese Datei enthält ausschließlich Platzhalter. Kopieren Sie sie nach .env, tragen Sie Ihre
# Werte ein und committen Sie die Kopie niemals; .env ist in .gitignore ausgenommen.
#
# WICHTIG: Der Server liest diese Datei NICHT selbst ein. Er hat keine Abhängigkeit, die das
# könnte, und liest die Werte ausschließlich aus der Prozessumgebung. Drei Wege, sie dorthin
# zu bekommen:
#   1. In der Shell:            set -a; . ./.env; set +a
#   2. Im Client:               die Werte in den env-Block der MCP-Konfiguration eintragen
#   3. Über den Assistenten:    bbutler-mcp setup legt sie in einer Zugangsdatendatei mit den
#                               Rechten 0600 ab; die Clientkonfiguration bleibt dann geheimnisfrei
#
# Alle Werte werden einmal beim Start gelesen. Eine Änderung wirkt erst nach einem Neustart des
# Servers, also in der Regel nach einem Neustart des Clients.
#
# Präfixe: BB_ beschreibt die Verbindung zur API, BB_MCP_ steuert das Verhalten dieses Servers.
# Eine unbekannte BB_-Variable erzeugt eine Warnung auf stderr mit dem ähnlichsten bekannten
# Namen; ein unbrauchbarer Wert bricht den Start ab, statt still auf die Vorgabe zurückzufallen.

# --- Pflicht ---------------------------------------------------------------------------------

# API Client: Benutzername der HTTP-Basic-Authentifizierung.
# Zu finden in BuchhaltungsButler unter Einstellungen, Bereich Schnittstellen beziehungsweise
# API-Zugang. Keine Vorgabe.
BB_API_CLIENT=PLATZHALTER_API_CLIENT

# API Secret: Passwort der HTTP-Basic-Authentifizierung. Keine Vorgabe.
BB_API_SECRET=PLATZHALTER_API_SECRET

# API Key: wird im Body jeder Anfrage mitgeschickt und WÄHLT DEN MANDANTEN.
# Das ist kein harmloser Bezeichner: Ein falscher Wert bedeutet richtige Anmeldung und falsche
# Buchhaltung. Keine Vorgabe.
BB_API_KEY=PLATZHALTER_API_KEY

# Fehlt einer der drei Werte, startet der Server trotzdem und meldet alle 59 Werkzeuge; jeder
# Aufruf antwortet dann mit einem Fehler, der die fehlende Variable nennt. Sind alle drei
# gesetzt, gelten sie, und die Zugangsdatendatei wird nicht gelesen. Teilweise gesetzte Werte
# mischen sich nicht mit der Datei.

# --- Verbindung, optional --------------------------------------------------------------------

# Basis-URL der API. Muss https: sein; http: ist nur gegen localhost zulässig.
# Vorgabe: https://webapp.buchhaltungsbutler.de/api/v1
# BB_BASE_URL=https://webapp.buchhaltungsbutler.de/api/v1

# Profilname in der Zugangsdatendatei, für mehrere Mandanten. Vorgabe: default
# BB_PROFILE=default

# Ort der Zugangsdatendatei.
# Vorgabe: ${XDG_CONFIG_HOME:-~/.config}/buchhaltungsbutler-mcp, unter Windows
# %APPDATA%\buchhaltungsbutler-mcp
# BB_CONFIG_DIR=/PLATZHALTER/PFAD/ZUM/KONFIGURATIONSVERZEICHNIS

# --- Schutzschalter, optional ------------------------------------------------------------------

# true beschränkt den Server auf die 15 lesenden Endpunkte. Die 39 schreibenden Werkzeuge lehnen
# dann ab, bevor eine Anfrage hinausgeht, bleiben aber in der Werkzeugliste sichtbar.
# Wird nur beim Start gelesen und ist aus einem Gespräch heraus nicht aufhebbar.
# Folge: BWA und Summen- und Saldenliste sind dann nicht erzeugbar, das Kontenblatt schon.
# Vorgabe: false
# BB_MCP_READ_ONLY=false

# --- Werkzeuggruppen, optional -------------------------------------------------------------------

# Der Gruppenschalter spart KONTEXT, nicht Zugriff. Alle 54 Werkzeugdefinitionen zusammen wiegen
# gemessen 48.368 Token, und Claude Desktop lädt sie im ungünstigsten Modus in jede Anfrage.
# Wer nur auswertet, braucht davon einen Bruchteil. Wer den Zugriff begrenzen will, nimmt
# BB_MCP_READ_ONLY; abgeschaltete Gruppen werden gar nicht erst angemeldet und sagen deshalb
# auch nicht ab, sie sind schlicht nicht da.
#
# Zwölf gültige Gruppennamen, mit Zahl der Werkzeuge und gemessenem Tokenpreis:
#   postings 12/12.213      receipts 8/8.529        transactions 8/6.661
#   invoices 3/5.766        creditors 4/3.341       reports 5/3.203
#   debtors 4/3.198         postingaccounts 3/1.877 cost_locations 4/1.839
#   payment_accounts 2/1.142  comments 1/599        bundles (Bündelwerkzeuge)
#
# Positivliste: nur diese Gruppen sind aktiv. Nicht gesetzt oder leer heißt: alle.
# Vorgabe: nicht gesetzt
# BB_MCP_TOOL_GROUPS=bundles,receipts,payment_accounts

# Negativliste: diese Gruppen werden abgezogen. Für den Fall "alles außer einer".
# Vorgabe: nicht gesetzt
# BB_MCP_TOOL_GROUPS_EXCLUDE=invoices

# Beide gleichzeitig zu setzen ist ein Startfehler, ebenso ein unbekannter Gruppenname, ein
# Ausschluss ohne Wirkung und eine Einstellung, die keine Gruppe übrig lässt. Der Server bricht
# dann ab und nennt die zwölf gültigen Namen; still abgeschaltete Werkzeuge gibt es nicht.
# Ein LEERER Wert ist ausdrücklich kein Fehler und gilt wie "nicht gesetzt".

# --- Weitere Grenzen, optional -------------------------------------------------------------------

# Obergrenze je Aufruf für jedes Stapel- und Positionsarray, also auch für die Positionen einer
# Splitbuchung oder einer Rechnung. Zulässig 1 bis 50; wirksam ist der kleinere der beiden Werte.
# Vorgabe: 50
# BB_MCP_MAX_BATCH=50

# Betragsgrenze für anlegende und buchende Werkzeuge mit Betragsfeld, als Dezimalzeichenkette
# mit Punkt. Vorgabe: nicht gesetzt, also aus.
# BB_MCP_MAX_AMOUNT=10000.00

# Duplikatshinweis vor jedem anlegenden Aufruf: on oder off.
# Bei on setzt der Server einen ZUSÄTZLICHEN lesenden Aufruf ab und verbraucht damit ein zweites
# Token aus dem Minutenkontingent des Mandanten. Bei Stapelwerkzeugen läuft er einmal für den
# ganzen Stapel. Ein Treffer blockiert nichts, sondern steht sichtbar in der Antwort.
# Vorgabe: off
# BB_MCP_DUPLICATE_CHECK=off

# --- Laufzeit, optional ------------------------------------------------------------------------

# Nachfüllrate des Standardeimers je Minute, zulässig 10 bis 100. Die API erlaubt 100 Anfragen je
# Mandant und Minute; die Vorgabe hält Abstand, weil der Mandant selten allein benutzt wird.
# Vorgabe: 60
# BB_MCP_RATE_LIMIT=60

# Zeitlimit der Stufe "normal" in Millisekunden, mindestens 5000. Vorgabe: 30000
# BB_MCP_TIMEOUT_MS=30000

# Weiche Kürzungsgrenze je Antwort in Token. Vorgabe: 5000
# BB_MCP_MAX_RESPONSE_TOKENS=5000

# Haltbarkeit des Stammdatenspeichers in Millisekunden; 0 schaltet ihn ab. Bewegungsdaten und
# Zahlungskonten werden nie zwischengespeichert. Vorgabe: 0
# BB_MCP_CACHE_TTL_MS=0

# Protokollstufe: error, warn, info oder debug. Ausgabe ausschließlich auf stderr, niemals auf
# stdout. Vorgabe: warn
# BB_MCP_LOG_LEVEL=warn

# --- Belegdateien, optional --------------------------------------------------------------------
#
# WARNUNG: Beide Variablen erweitern die Angriffsfläche. Stammt ein Pfad oder eine Adresse aus
# einem Text, den der Assistent zuvor gelesen hat, entscheidet nicht mehr allein der Nutzer,
# welche Datei hochgeladen wird. Ohne diese Variablen nimmt der Server Belegdateien
# ausschließlich als base64-Zeichenkette an, und das funktioniert immer.

# Liste erlaubter Verzeichnisse für file:// als Belegquelle, getrennt durch den Pfadtrenner des
# Betriebssystems. Nur eng umrissene Ablageverzeichnisse eintragen, niemals das
# Heimatverzeichnis. Vorgabe: leer, also kein Dateisystemzugriff.
# BB_MCP_UPLOAD_DIRS=/PLATZHALTER/PFAD/ZUM/BELEGORDNER

# true erlaubt https:// als Belegquelle. Vorgabe: false
# BB_MCP_UPLOAD_FROM_URL=false

# --- Veraltet -----------------------------------------------------------------------------------

# BB_READ_ONLY wird noch akzeptiert, erzeugt aber eine Warnung auf stderr. Kanonisch ist
# BB_MCP_READ_ONLY. Sind beide gesetzt und widersprechen sich, bricht der Server beim Start ab.
# Bitte nicht mehr benutzen.
