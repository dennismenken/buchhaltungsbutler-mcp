# Abhängigkeiten
node_modules/

# Build-Artefakte
dist/
*.tsbuildinfo
# Gebautes Bundle im Wurzelverzeichnis. Nur das Artefakt, nicht das Verzeichnis .mcpb/
# mit der Manifestvorlage: Das Muster *.mcpb wuerde auch den Verzeichnisnamen .mcpb
# erfassen, weil * auch die leere Zeichenkette trifft.
/bbutler-mcp-*.mcpb

# Erzeugter Registerindex. Einziges Generat, das nicht eingecheckt wird:
# Es leitet sich allein aus dem Inhalt von src/registry/tools/ ab und wird vor build,
# test und typecheck neu erzeugt. Eingecheckt wäre es die eine geteilte Datei, die alle
# fünf Registerpakete gleichzeitig anfassen müssten.
src/registry/index.generated.ts

# Zugangsdaten (niemals committen)
.env
.env.*
!.env.example
*.pem
*.key

# Logs und Caches
*.log
npm-debug.log*
.npm/
coverage/
.vitest/

# Betriebssystem und Editor
.DS_Store
.idea/
.vscode/
.claude/
.codex/
.grok/
.kimi-code/
.vord/
